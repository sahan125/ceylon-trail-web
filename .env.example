# Supabase Credentials (Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Portal Authentication (Single Site Owner Credentials)
ADMIN_EMAIL=admin@ceylontrail.com
ADMIN_PASSWORD=CeylonTrail@Admin2026!
ADMIN_SESSION_SECRET=your-random-32-character-secret-key-for-admin-jwt-session
